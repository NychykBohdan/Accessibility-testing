{
  "name": "saucedemo-a11y-testing",
  "version": "1.0.0",
  "private": true,
  "description": "Automated accessibility (WCAG 2.1 AA) testing of saucedemo.com with Playwright + axe-core",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "playwright test",
    "test:a11y": "playwright test tests/a11y",
    "test:keyboard": "playwright test tests/keyboard",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "a11y:summary": "node scripts/a11y-summary.ts",
    "baseline:update": "node scripts/baseline-update.ts",
    "pages:build": "node scripts/build-pages.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "playwright",
    "axe-core"
  ],
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.19.17",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
